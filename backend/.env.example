PORT=4000
MONGO_URI=mongodb://mongo_user:mongo_password@mongo:27017/mahu?authSource=admin
REDIS_URL=redis://:redis_password@redis:6379
JWT_SECRET=replace-with-a-long-random-string
SERVICE_API_KEY=replace-with-a-long-random-string
# Liste separee par des virgules - le premier est utilise par defaut si
# l'Origin de la requete ne correspond a aucun de ceux listes.
CORS_ORIGIN=https://your-domain.com,https://ai-beta.your-domain.com

# Firebase Admin (depuis Firebase Console > Parametres du projet > Comptes de service > Generer une nouvelle cle privee)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Garder les \n litteraux (pas de vrais retours a la ligne) dans cette variable
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExxxxx...\n-----END PRIVATE KEY-----\n"

# Mode IA - LiteLLM (proxy interne, jamais expose publiquement)
LITELLM_URL=http://litellm:4001
LITELLM_MASTER_KEY=replace-with-a-long-random-string
# Cles des fournisseurs IA, lues par le conteneur litellm (voir litellm/config.yaml)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Alibaba Cloud Model Studio (Qwen) - cle + endpoint generes sur
# modelstudio.console.alibabacloud.com (espace de travail > cle API). L'endpoint
# est scope a ton espace de travail, pas le host DashScope public generique.
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://your-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Mode IA - PayDunya (paiement des abonnements)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
# URL publique du backend (VPS) pour que PayDunya puisse appeler le webhook directement
PAYDUNYA_WEBHOOK_URL=https://api.your-domain.com/api/billing/webhook/paydunya
# URL du front vers laquelle rediriger l'utilisateur apres paiement, et base
# des liens generes dans les emails (bienvenue, reset password, profil public)
APP_URL=https://your-domain.com

# SMTP - emails transactionnels (bienvenue, reset mot de passe, notifications
# prospects/support), remplace l'ancien GmailApp. Pour Gmail : active la
# validation en 2 etapes puis genere un "mot de passe d'application"
# (myaccount.google.com/apppasswords) - n'utilise jamais ton mot de passe Gmail normal ici.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@mahu.cards
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_FROM_NAME=MAHU DIGITAL SYSTEM
SMTP_FROM_EMAIL=contact@mahu.cards

# CallMeBot - notifications WhatsApp a l'admin (commandes, support, activation
# de carte). Voir https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# Emails autorises pour les actions super-admin (adminRegisterClient,
# adminCreateReseller, adminGenerateCardCodes, adminAssignCardLot,
# adminBroadcastMessage) - liste separee par des virgules.
SUPER_ADMIN_EMAILS=abmcompanysn@gmail.com

# Cloudinary - reprend le meme preset non-signe deja utilise cote client
# (voir lib/cloudinary.ts), pour l'upload serveur de adminRegisterClient.
CLOUDINARY_CLOUD_NAME=dl3cdiz6k
CLOUDINARY_UPLOAD_PRESET=mahucards

# PawaPay - paiement mobile money (Orange Money, Wave, Free Money...), en plus
# de PayDunya. Token genere sur dashboard.pawapay.io (sandbox.pawapay.io pour tester).
PAWAPAY_API_TOKEN=
PAWAPAY_MODE=sandbox
# Pays (ISO3) offerts sur la page de paiement PawaPay, separes par des virgules.
PAWAPAY_COUNTRIES=SEN
PAWAPAY_CURRENCY=XOF

# Connecteur Gmail - permet a un UTILISATEUR de connecter son propre compte
# Gmail pour envoyer des emails en son nom (voir /dashboard/settings). A
# creer sur console.cloud.google.com : nouveau projet > API Gmail activee >
# ecran de consentement OAuth > identifiants > ID client OAuth (type "Web").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Doit etre exactement l'URL publique de CE backend (pas du frontend) et etre
# ajoutee telle quelle dans "URI de redirection autorisees" sur Google Cloud.
GOOGLE_OAUTH_REDIRECT_URL=https://api.your-domain.com/api/connectors/gmail/callback

# Connecteur YouTube - reutilise le MEME projet/identifiant Google OAuth que
# Gmail ci-dessus (juste activer l'API YouTube Data v3 dans ce projet), mais
# a besoin de sa propre URI de redirection ajoutee en plus de celle de Gmail.
YOUTUBE_REDIRECT_URL=https://api.your-domain.com/api/connectors/youtube/callback

# Connecteur Facebook - publie sur la Page Facebook de l'utilisateur, ET
# connecte automatiquement Instagram si un compte Instagram Business est lie
# a cette Page (pas de connecteur Instagram separe). A creer sur
# developers.facebook.com/apps (produit "Facebook Login for Business").
# Necessite une App Review Meta avant de fonctionner pour d'autres personnes
# que les testeurs/admins de l'app (scopes pages_manage_posts,
# instagram_content_publish notamment).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=https://api.your-domain.com/api/connectors/facebook/callback

# Connecteur TikTok - connexion + publication video. Publication video reste
# PRIVEE tant que l'app n'a pas ete auditee par TikTok (limite imposee par
# TikTok, pas par ce code). A creer sur developers.tiktok.com ("Login Kit" +
# "Content Posting API").
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URL=https://api.your-domain.com/api/connectors/tiktok/callback

# Connecteur LinkedIn - publie une video sur le profil de l'utilisateur. A
# creer sur developers.linkedin.com (produits "Sign In with LinkedIn using
# OpenID Connect" + "Share on LinkedIn").
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=https://api.your-domain.com/api/connectors/linkedin/callback
