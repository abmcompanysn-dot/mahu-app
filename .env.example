# Backend Node (VPS) - utilise par app/api/backend/[...path]/route.ts
# Doit correspondre a SERVICE_API_KEY dans backend/.env
BACKEND_URL=http://127.0.0.1:4000
BACKEND_API_KEY=replace-with-the-same-value-as-backend-SERVICE_API_KEY

# Firebase (client) - depuis Firebase Console > Parametres du projet > Vos applications > Config SDK
# Ces valeurs sont publiques par design (NEXT_PUBLIC_*), la securite vient des regles Firebase, pas du secret
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
